# ── Frontend (set in the Vercel dashboard) ────────────────────────────
# URL of the Cloudflare Worker backend. Use the https:// form — the client
# rewrites it to wss:// itself. Leave UNSET for local dev so that the Vite
# proxy in vite.config.ts forwards /ws to `wrangler dev` on localhost:8787.
VITE_SERVER_URL=https://mindi-server.<your-subdomain>.workers.dev

# ── Backend (Cloudflare Worker) ───────────────────────────────────────
# Not read from this file. Set CLIENT_ORIGIN in worker/wrangler.toml under
# [vars] — a comma-separated allowlist of extra origins.
# *.crazygames.com and localhost are always allowed.
