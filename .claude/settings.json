{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "enabledMcpjsonServers": ["code-review-graph"],

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph status",
            "timeout": 10,
            "statusMessage": "Checking code graph..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph update --skip-flows",
            "timeout": 60,
            "async": true,
            "statusMessage": "Updating code graph..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "code-review-graph detect-changes --brief",
            "if": "Bash(git commit *)",
            "timeout": 30,
            "statusMessage": "Risk-scoring staged changes..."
          }
        ]
      }
    ]
  },

  "permissions": {
    "allow": [
      "Bash(code-review-graph:*)",

      "Bash(pnpm run:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm list:*)",
      "Bash(pnpm install)",
      "Bash(pnpm install --frozen-lockfile)",
      "Bash(npm run:*)",
      "Bash(npm --prefix server run:*)",
      "Bash(npx tsc:*)",
      "Bash(node_modules/.bin/tsc --noEmit)",
      "Bash(node_modules/.bin/vite build:*)",

      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch:*)",
      "Bash(git ls-files:*)",
      "Bash(git config --list)",

      "WebFetch(domain:docs.crazygames.com)",
      "WebFetch(domain:developer.crazygames.com)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git reset --hard:*)"
    ]
  },

  "worktree": {
    "symlinkDirectories": ["node_modules"]
  }
}
