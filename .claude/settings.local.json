{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:www.reddit.com)",
      "Bash(claude plugin:*)",
      "Bash(gh api:*)",
      "Bash(npm --version)",
      "Bash(pnpm add:*)",
      "Bash(npm install:*)",
      "Bash(npm --prefix server install)",
      "Bash(pip install:*)",
      "Bash(xargs grep:*)",
      "Bash(xargs cat:*)",
      "WebFetch(domain:magazine.artstation.com)",
      "WebFetch(domain:devotedstudios.com)",
      "WebFetch(domain:www.artstation.com)",
      "WebFetch(domain:interfaceingame.com)",
      "WebFetch(domain:www.escapistmagazine.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:www.graphicpie.com)",
      "WebFetch(domain:bundlephobia.com)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:unpkg.com)",
      "WebFetch(domain:registry.npmjs.org)",
      "WebFetch(domain:fallguysultimateknockout.fandom.com)",
      "WebFetch(domain:fonts.google.com)",
      "WebFetch(domain:en.wikipedia.org)"
    ]
  }
}
