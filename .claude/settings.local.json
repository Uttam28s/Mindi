{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "WebSearch",
      "WebFetch(domain:raw.githubusercontent.com)",
      "WebFetch(domain:www.reddit.com)",

      "Bash(claude plugin:*)",
      "Bash(gh api:*)",

      "Bash(npm --version)",
      "Bash(pnpm add:*)",
      "Bash(npm install:*)",
      "Bash(npm --prefix server install)",
      "Bash(pip install:*)",

      "Bash(xargs grep:*)",
      "Bash(xargs cat:*)"
    ]
  }
}
